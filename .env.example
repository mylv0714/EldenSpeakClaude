# Copy to .env.local and fill in. Server-only values: never expose these to the client bundle.

# Any OpenAI-compatible Chat Completions endpoint (OpenRouter recommended).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-oss-20b
# OpenRouter reasoning effort: low | medium (default) | high. Medium keeps gpt-oss JSON reliable.
# OPENAI_REASONING_EFFORT=medium

# Max AI requests per client per day (0 = unlimited).
CHAT_DAILY_LIMIT=0

# Optional: neural character voices (any OpenAI-compatible /audio/speech endpoint).
# Without a key the game uses the browser/device voices.
# TTS_API_KEY=
# TTS_BASE_URL=https://api.openai.com/v1
# TTS_MODEL=gpt-4o-mini-tts

# Optional
# PORT=8787
# Extra allowed CORS origins, comma separated (Capacitor/dev origins are allowed by default).
# CORS_ORIGINS=https://eldenspeak.app

# Client build (Android): absolute URL of the deployed API server. Put this in .env.android.
# VITE_API_BASE_URL=https://api.example.com
